<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:controller="com.example.lab4.LayoutController"
            fx:id="rootPane"
            stylesheets="@style.css"
            maxHeight="-Infinity" maxWidth="-Infinity" minHeight="520.0" minWidth="760.0" prefHeight="600.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <HBox BorderPane.alignment="CENTER" alignment="CENTER_LEFT" fx:id="topBar" spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <children>
                <Label text="Каталог фильмов"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnAdd" mnemonicParsing="false" onAction="#onSaveClick" text="Добавить"/>
                <Button fx:id="btnClear" mnemonicParsing="false" onAction="#onClearClick" text="Очистить"/>
            </children>
        </HBox>
    </top>

    <left>
        <VBox BorderPane.alignment="CENTER" fx:id="navigationBox" prefWidth="160.0" spacing="8.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <children>
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="📋 Все фильмы"/>
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="⭐ Избранное"/>
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="⚙ Настройки"/>
            </children>
        </VBox>
    </left>

    <center>
        <VBox BorderPane.alignment="CENTER" fx:id="contentBox" spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <children>
                <GridPane fx:id="formGrid" hgap="10.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="120.0" minWidth="100.0" prefWidth="110.0"/>
                        <ColumnConstraints hgrow="ALWAYS" maxWidth="1.7976931348623157E308" minWidth="10.0" prefWidth="300.0"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="30.0" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="30.0" vgrow="SOMETIMES"/>
                        <RowConstraints minHeight="30.0" vgrow="SOMETIMES"/>
                    </rowConstraints>
                    <children>
                        <Label text="Название"/>
                        <TextField GridPane.columnIndex="1" fx:id="txtTitle" maxWidth="1.7976931348623157E308" promptText="Например: Интерстеллар"/>

                        <Label GridPane.rowIndex="1" text="Жанр"/>
                        <TextField GridPane.columnIndex="1" GridPane.rowIndex="1" fx:id="txtGenre" maxWidth="1.7976931348623157E308" promptText="Например: Фантастика"/>

                        <Label GridPane.rowIndex="2" text="Год выхода"/>
                        <ComboBox GridPane.columnIndex="1" GridPane.rowIndex="2" fx:id="cmbYear" maxWidth="1.7976931348623157E308"/>
                    </children>
                </GridPane>

                <TableView VBox.vgrow="ALWAYS" fx:id="tblMovies">
                    <columns>
                        <TableColumn fx:id="colPoster" prefWidth="80.0" text="Обложка"/>
                        <TableColumn fx:id="colTitle" prefWidth="220.0" text="Название фильма"/>
                        <TableColumn fx:id="colGenre" prefWidth="160.0" text="Жанр"/>
                        <TableColumn fx:id="colYear" prefWidth="100.0" text="Год выхода"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </center>

    <bottom>
        <HBox BorderPane.alignment="CENTER" fx:id="bottomBar">
            <padding>
                <Insets bottom="5.0" left="10.0" right="10.0" top="5.0"/>
            </padding>
            <children>
                <Label fx:id="lblStatus" text="Статус: приложение готово с поддержкой обложек"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>