<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane style="-fx-background-color: #121212;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.HelloController">
    <top>
        <VBox alignment="CENTER" spacing="10" style="-fx-background-color: #1e1e1e; -fx-padding: 15;">
            <Label style="-fx-text-fill: #ff4d4d; -fx-font-weight: bold;" text="🎬 КИНОБАЗА: МЕДИАТЕКА">
                <font>
                    <Font name="System Bold" size="22.0" />
                </font>
            </Label>
            <HBox alignment="CENTER" spacing="10">
                <Label style="-fx-text-fill: #ffffff;" text="Выберите фильм:" />
                <ComboBox fx:id="cmbSelectMovie" onAction="#onMovieSelected" prefWidth="300.0" style="-fx-background-color: #2b2b2b; -fx-text-inner-color: white;" />
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="20" style="-fx-padding: 20;">
            <VBox prefWidth="320.0" spacing="12">
                <GridPane hgap="10" vgap="10">
                    <Label style="-fx-text-fill: #b0b0b0;" text="Название:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="txtTitle" style="-fx-background-color: #2b2b2b; -fx-text-fill: white;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label style="-fx-text-fill: #b0b0b0;" text="Жанр:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <ComboBox fx:id="cmbGenre" prefWidth="180.0" style="-fx-background-color: #2b2b2b;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label style="-fx-text-fill: #b0b0b0;" text="Год выпуска:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <TextField fx:id="txtYear" style="-fx-background-color: #2b2b2b; -fx-text-fill: white;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <Label style="-fx-text-fill: #b0b0b0;" text="Рейтинг (0-10):" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <TextField fx:id="txtRating" style="-fx-background-color: #2b2b2b; -fx-text-fill: white;" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                    <Label style="-fx-text-fill: #b0b0b0;" text="Длительность:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                    <TextField fx:id="txtDuration" style="-fx-background-color: #2b2b2b; -fx-text-fill: white;" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                    <Label style="-fx-text-fill: #b0b0b0;" text="Страна:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                    <ComboBox fx:id="cmbCountry" prefWidth="180.0" style="-fx-background-color: #2b2b2b;" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                </GridPane>

                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label style="-fx-text-fill: #b0b0b0;" text="Формат:" />
                    <RadioButton fx:id="rb2D" selected="true" style="-fx-text-fill: white;" text="2D">
                        <toggleGroup>
                            <ToggleGroup fx:id="groupFormat" />
                        </toggleGroup>
                    </RadioButton>
                    <RadioButton fx:id="rb3D" style="-fx-text-fill: white;" text="3D / IMAX" toggleGroup="$groupFormat" />
                </HBox>

                <CheckBox fx:id="chkSubtitles" style="-fx-text-fill: white;" text="Наличие субтитров" />

                <HBox spacing="10" style="-fx-padding: 10 0 0 0;">
                    <Button onAction="#onCreateClick" style="-fx-background-color: #e50914; -fx-text-fill: white; -fx-font-weight: bold;" text="Сохранить" />
                    <Button onAction="#onClearClick" style="-fx-background-color: #444444; -fx-text-fill: white;" text="Очистить" />
                    <Button onAction="#onExitClick" style="-fx-background-color: #222222; -fx-text-fill: #888888;" text="Выход" />
                </HBox>

                <Label fx:id="lblResult" style="-fx-text-fill: #00ffcc; -fx-font-size: 13px;" wrapText="true" />
            </VBox>

            <!-- Блок обложки с кнопкой загрузки -->
            <VBox alignment="CENTER" spacing="10" style="-fx-background-color: #1e1e1e; -fx-padding: 15; -fx-background-radius: 12; -fx-border-color: #333333; -fx-border-radius: 12;">
                <ImageView fx:id="imgPoster" fitHeight="340.0" fitWidth="240.0" pickOnBounds="true" preserveRatio="true" />
                <Button onAction="#onSelectImageClick" style="-fx-background-color: #333333; -fx-text-fill: white; -fx-cursor: hand;" text="Загрузить свою обложку" />
            </VBox>
        </HBox>
    </center>
</BorderPane>