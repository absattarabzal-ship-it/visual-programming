<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane style="-fx-background-color: #121212;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kz.atu.lab6.CatalogController">
    <top>
        <VBox spacing="12.0" style="-fx-background-color: #1f1f1f; -fx-border-color: #333333; -fx-border-width: 0 0 1 0;" BorderPane.alignment="CENTER">
            <children>
                <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #e50914;" text="🎬 КИНЕМАТОГРАФ" />
                <HBox spacing="10.0">
                    <children>
                        <TextField fx:id="txtSearch" promptText="🔍 Поиск фильма..." style="-fx-background-color: #2b2b2b; -fx-text-fill: white; -fx-prompt-text-fill: #aaaaaa; -fx-background-radius: 20; -fx-padding: 8 12;" HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="cmbFilterGenre" prefWidth="160.0" promptText="Жанр" style="-fx-background-color: #2b2b2b; -fx-mark-color: white;" />
                        <Button onAction="#onClearFilterClick" style="-fx-background-color: #e50914; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-cursor: hand;" text="Сбросить" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
            </padding>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.22" style="-fx-background-color: #121212; -fx-padding: 10;" BorderPane.alignment="CENTER">
            <items>
                <VBox spacing="8.0" style="-fx-background-color: #1f1f1f; -fx-background-radius: 8;">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #e50914; -fx-font-size: 14px;" text="📂 Жанры" />
                        <ListView fx:id="listGenres" style="-fx-background-color: #121212; -fx-control-inner-background: #121212; -fx-background-radius: 6;" VBox.vgrow="ALWAYS" />
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </VBox>
                <TableView fx:id="tableMovies" style="-fx-background-color: #1f1f1f; -fx-control-inner-background: #181818; -fx-table-cell-border-color: #2b2b2b;">
                    <columns>
                        <TableColumn fx:id="colPoster" prefWidth="70.0" style="-fx-alignment: CENTER;" text="Обложка" />
                        <TableColumn fx:id="colTitle" prefWidth="180.0" text="Название" />
                        <TableColumn fx:id="colGenre" prefWidth="110.0" text="Жанр" />
                        <TableColumn fx:id="colYear" prefWidth="70.0" style="-fx-alignment: CENTER;" text="Год" />
                        <TableColumn fx:id="colRating" prefWidth="70.0" style="-fx-alignment: CENTER;" text="Рейтинг" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </items>
        </SplitPane>
    </center>
    <bottom>
        <VBox spacing="12.0" style="-fx-background-color: #1f1f1f; -fx-border-color: #333333; -fx-border-width: 1 0 0 0;" BorderPane.alignment="CENTER">
            <children>
                <GridPane hgap="12.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="80.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="180.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="80.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="180.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="32.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="32.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="32.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #aaaaaa;" text="Название:" />
                        <TextField fx:id="txtTitle" style="-fx-background-color: #2b2b2b; -fx-text-fill: white;" GridPane.columnIndex="1" />
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #aaaaaa;" text="Жанр:" GridPane.columnIndex="2" />
                        <ComboBox fx:id="cmbGenre" prefWidth="200.0" style="-fx-background-color: #2b2b2b;" GridPane.columnIndex="3" />
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #aaaaaa;" text="Год:" GridPane.rowIndex="1" />
                        <TextField fx:id="txtYear" style="-fx-background-color: #2b2b2b; -fx-text-fill: white;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #aaaaaa;" text="Рейтинг:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <TextField fx:id="txtRating" style="-fx-background-color: #2b2b2b; -fx-text-fill: white;" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #aaaaaa;" text="Ссылка URL:" GridPane.rowIndex="2" />
                        <TextField fx:id="txtImageUrl" promptText="https://..." style="-fx-background-color: #2b2b2b; -fx-text-fill: white;" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="2" />
                    </children>
                </GridPane>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Button onAction="#onAddClick" style="-fx-background-color: #2ea44f; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16; -fx-cursor: hand;" text="➕ Добавить фильм" />
                        <Button onAction="#onDeleteClick" style="-fx-background-color: #e50914; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16; -fx-cursor: hand;" text="🗑️ Удалить" />
                        <Label fx:id="lblCount" style="-fx-font-weight: bold; -fx-text-fill: #e50914; -fx-font-size: 13px;" text="Найдено записей: 0">
                            <HBox.margin>
                                <Insets left="20.0" />
                            </HBox.margin>
                        </Label>
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
            </padding>
        </VBox>
    </bottom>
</BorderPane>